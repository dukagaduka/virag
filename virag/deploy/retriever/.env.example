###################
# DEPLOY SETTINGS #
###################

RETRIEVER_DEPLOY_PORT=48004
RETRIEVER_DEPLOY_HOST=0.0.0.0
RETRIEVER_DEPLOY_IMAGE=vllm/vllm-openai:v0.32.0
RETRIEVER_DEPLOY_CONTAINER_NAME=your-retriever-container-name
RETRIEVER_DEPLOY_MODEL_PATH=/path/to/local/base/model
# LoRA adapter host path. Mounted read-only at the constant internal path /adapter.
# If you don't use an adapter, point this at the base model dir (no adapter_config.json
# there → LoRA stays off).
RETRIEVER_DEPLOY_ADAPTER_PATH=/path/to/lora/adapter

# Bearer key the server requires on /v1/* (compose passes it in as VLLM_API_KEY; the
# healthcheck sends it too). virag's RETRIEVER_API_KEY must be the same.
RETRIEVER_DEPLOY_API_KEY=dummy
