###################
# DEPLOY SETTINGS #
###################

RERANKER_DEPLOY_PORT=48005
RERANKER_DEPLOY_HOST=0.0.0.0
RERANKER_DEPLOY_IMAGE=vllm/vllm-openai:v0.32.0
RERANKER_DEPLOY_CONTAINER_NAME=your-reranker-container-name
RERANKER_DEPLOY_MODEL_PATH=/path/to/Qwen3-VL-Reranker-2B

# Mounted read-only at /media. Rerank requests can then reference screenshots as
# file:///media/<path> instead of sending base64. Point at any dir if unused.
RERANKER_DEPLOY_MEDIA_PATH=/path/to/screenshots

# Bearer key the server requires on /v1/* (compose passes it in as VLLM_API_KEY; the
# healthcheck sends it too).
RERANKER_DEPLOY_API_KEY=dummy
