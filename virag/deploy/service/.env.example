###################
# DEPLOY SETTINGS #
###################

VIRAG_DEPLOY_PORT=48000
VIRAG_DEPLOY_HOST=0.0.0.0
VIRAG_DEPLOY_IMAGE=virag:0.1.0
VIRAG_DEPLOY_CONTAINER_NAME=virag-service


TILER_DEPLOY_PORT=48001
TILER_DEPLOY_HOST=0.0.0.0
TILER_DEPLOY_IMAGE=tiler:3.2.0
TILER_DEPLOY_CONTAINER_NAME=tiler-service
TILER_DEPLOY_VOLUME_PATH=/path/to/your/volume


QDRANT_DEPLOY_PORT=48002
QDRANT_DEPLOY_HOST=0.0.0.0
QDRANT_DEPLOY_IMAGE=qdrant/qdrant:latest
QDRANT_DEPLOY_CONTAINER_NAME=your-qdrant-container-name
QDRANT_DEPLOY_VOLUME_PATH=/path/to/your/volume


#########################
# ORCHESTRATOR SETTINGS #
#########################

VIRAG_HOST=0.0.0.0
VIRAG_PORT=8080

# RAG defaults (per-request `rag` config overrides these)
VIRAG_TOP_N=5
VIRAG_SCORE_THRESHOLD= # empty = no threshold
VIRAG_FRAMING_TEXT= # empty = built-in default prompt prepended to retrieved tiles

# Enroll reconcile (self-repair of partial/orphaned enrolls)
VIRAG_SELF_HEAL=true # re-embed complete pending docs on reconcile (self-heal arrives with streaming)
VIRAG_RECONCILE_INTERVAL_SEC=300 # periodic reconcile cadence; 0 = startup-only
VIRAG_PENDING_TTL_SEC=3600 # pending age before reconcile acts (must exceed the longest enroll)

#########################
# UPSTREAM HTTP RETRIES #
#########################

# Shared by every upstream client (embeddings, tiler, VLM). Transient failures —
# connection errors and 429/502/503/504 — are replayed with full-jitter exponential
# backoff: each wait is uniform over [0, min(CAP, BASE * 2^attempt)]. A numeric
# Retry-After from the upstream takes precedence (still capped at CAP).
HTTP_RETRY_BACKOFF_BASE_SEC=0.25
HTTP_RETRY_BACKOFF_CAP_SEC=8

###################
# QDRANT SETTINGS #
###################

QDRANT_BASE_URL=http://qdrant-virag:6333
QDRANT_COLLECTION_NAME=your-collection-name
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE_TYPE=Cosine # Dot | Euclid | Manhattan | Cosine
QDRANT_CHUNK_SIZE=24 # Per-upsert body budget in MB (kept < Qdrant's 32 MB limit)
QDRANT_MAX_BATCH_CHUNKS=1024 # Hard cap on points per upsert request

#######################
# EMBEDDINGS SETTINGS #
#######################

EMBEDDINGS_BASE_URL=http://host.docker.internal:48003/v1 # /v1 is required; embeddings run in their own stack (deploy/embeddings), point at its host:VLLM_DEPLOY_PORT
VLLM_SERVED_MODEL_NAME=embeddings-model # must match SERVED_MODEL_NAME in deploy/embeddings/serve_embeddings.sh
VLLM_API_KEY=dummy # must match API_KEY there
EMBEDDINGS_CHUNK_SIZE=16
EMBEDDINGS_TIMEOUT_SEC=60 # per-read deadline (max silence between bytes)
EMBEDDINGS_CONNECT_TIMEOUT_SEC=10
EMBEDDINGS_MAX_CONNECTIONS=100 # pooled keep-alive connections to the embeddings server
EMBEDDINGS_MAX_RETRIES=3 # retries for a transient failure; 0 = no retry

################################
# UPSTREAM VLM SETTINGS        #
# (OpenAI-compatible; external #
#  to this deployment)         #
################################

VLM_BASE_URL=http://your-vlm-endpoint/v1 # /v1 is required
VLM_MODEL_NAME=your-vision-model
VLM_API_KEY=dummy
VLM_TIMEOUT_SEC=480 # per-read deadline on the VLM stream (max silence between chunks; covers a long prefill/TTFT on big pixel-RAG prompts), not total generation time
VLM_CONNECT_TIMEOUT_SEC=10
VLM_MAX_CONNECTIONS=100 # pooled keep-alive connections to the VLM; must be >= VLM_MAX_CONCURRENCY
VLM_MAX_CONCURRENCY=0 # max concurrent upstream chat-completion calls; 0 = unlimited. Cap it (e.g. 2) to shield a fragile/remote VLM from concurrent multimodal load — excess calls queue.
VLM_MAX_RETRIES=3 # retries for a transient failure (connection error or 429/502/503/504) while OPENING an upstream call, before any bytes stream; 0 = no retry. Never replays a partially-streamed response.

##################
# TILER SETTINGS #
##################

# Main Service Settings
TILER_BASE_URL=http://tiler-virag:8080
TILER_TIMEOUT_SEC=120 # per-read deadline for the tile stream (between events), not the whole render
TILER_CONNECT_TIMEOUT_SEC=10
TILER_MAX_CONNECTIONS=100 # pooled keep-alive connections to the tiler
TILER_MAX_RETRIES=3 # retries for a transient failure on idempotent calls; an ingest (tile stream) is never replayed

# Incomplete streaming-ingest sweeper (must exceed the longest render); 0 = off
TILER_INCOMPLETE_TTL_SEC=7200
TILER_SWEEP_INTERVAL_SEC=300

# Binding secret shared by tiler + qdrant + virag (single source of truth).
# Set BEFORE first init (immutable per volume, like geometry); empty = unbindable slot.
TILER_DB_SECRET=

# Tiler Service Settings
TILER_TILE_WIDTH=875
TILER_TILE_HEIGHT=1024
TILER_TILE_OVERLAP=20
TILER_MIN_TILE_HEIGHT=28

# --- PDF strip slicing (opt-in) ---
# Off by default: each PDF page stays one tile. When ON, each page is sliced into
# strips of TILER_PDF_TILE_HEIGHT (overlap TILER_PDF_TILE_OVERLAP), never across page
# boundaries — finer tiles improve retrieval recall on dense text pages. Enabling it
# (or changing the two sizes) changes render_version → re-enroll PDFs to pick it up.
TILER_PDF_SLICE_ENABLE=false
TILER_PDF_TILE_HEIGHT=1024
TILER_PDF_TILE_OVERLAP=0

# --- pixel tier ---
TILER_JPEG_QUALITY=85
TILER_PDF_DPI=200

# --- runtime ---
TILER_N_BROWSERS=4
TILER_RECYCLE_AFTER=500
TILER_RENDER_CACHE_SIZE=64
TILER_MAX_DOC_BYTES=67108864
TILER_NAV_TIMEOUT_MS=30000
TILER_WAIT_NETWORK_IDLE=true
TILER_SAFE_FULLPAGE_PX=30000
TILER_RENDER_MISMATCH_POLICY=strict
TILER_URL_FETCH_ENABLED=true
TILER_URL_ALLOW_PRIVATE=false
TILER_ALLOW_DELETE=false
TILER_LOG_LEVEL=INFO
