# Compose itself: images, container names, published hosts/ports, volume paths. Copy to
# .env (git-ignored). No container reads this file — virag reads virag.env, the tiler
# tiler.env; Valkey and Qdrant take their secrets from configs/.

###################
# DEPLOY SETTINGS #
###################

VIRAG_DEPLOY_PORT=48000
VIRAG_DEPLOY_HOST=0.0.0.0 # virag guards itself with VIRAG_API_KEY; reachable from other containers via host.docker.internal
VIRAG_DEPLOY_IMAGE=virag:0.1.0
VIRAG_DEPLOY_CONTAINER_NAME=virag-service


TILER_DEPLOY_PORT=48001
TILER_DEPLOY_HOST=127.0.0.1 # for tools on this host; virag reaches the tiler inside the network
TILER_DEPLOY_IMAGE=tiler:3.2.0
TILER_DEPLOY_CONTAINER_NAME=tiler-service
TILER_DEPLOY_VOLUME_PATH=/path/to/your/volume


QDRANT_DEPLOY_PORT=48002
QDRANT_DEPLOY_GRPC_PORT=48003
QDRANT_DEPLOY_HOST=127.0.0.1 # for tools on this host (dashboard: http://127.0.0.1:48002/dashboard, with the API key)
QDRANT_DEPLOY_IMAGE=qdrant/qdrant:v1.20.0 # pinned: qdrant-client (pyproject) must stay within one minor version of the server
QDRANT_DEPLOY_CONTAINER_NAME=your-qdrant-container-name
QDRANT_DEPLOY_VOLUME_PATH=/path/to/your/volume


VALKEY_DEPLOY_IMAGE=valkey/valkey:9.1.3-alpine # 9.0+ required (SET IFEQ, DELIFEQ)
VALKEY_DEPLOY_CONTAINER_NAME=valkey-service
VALKEY_DEPLOY_VOLUME_PATH=/path/to/your/volume
